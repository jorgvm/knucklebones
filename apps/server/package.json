{
  "name": "@knucklebones/server",
  "type": "module",
  "version": "1.0.0",
  "description": "Socket.io game server",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node esbuild.config.js",
    "start": "node --max-old-space-size=200 dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "pnpm eslint './src/**/*.{ts,tsx}'",
    "supabase-generate-types": "SUPABASE_ACCESS_TOKEN=[pta-token] pnpm supabase gen types typescript --project-id [project-id]  > src/supabase/database.types.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {
    "@knucklebones/shared": "workspace:*",
    "@sentry/node": "^10.52.0",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "supabase": "^2.98.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  }
}
